# Azure Entra ID (Authentication)
AZURE_TENANT_ID=your-tenant-id
AZURE_CLIENT_ID=your-backend-app-registration-client-id
AZURE_CLIENT_ID_SPA=your-spa-app-registration-client-id

# Azure AI Foundry (Azure OpenAI)
AZURE_AI_FOUNDRY_ENDPOINT=https://your-resource.cognitiveservices.azure.com/
AZURE_AI_FOUNDRY_API_KEY=your-api-key
AZURE_AI_FOUNDRY_MODEL=gpt-4o
AZURE_AI_FOUNDRY_DEPLOYMENT=gpt-4o
AZURE_AI_FOUNDRY_API_VERSION=2024-04-01-preview

# Server
PORT=4000
FRONTEND_ORIGIN=http://localhost:3000

# Application Insights (Phase 6)
# APPLICATIONINSIGHTS_CONNECTION_STRING=your-connection-string
